{
  "name": "@fluxo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "types": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/index.js",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@fluxo/db": "workspace:*",
    "@fluxo/logger": "workspace:*",
    "@fluxo/redis": "workspace:*",
    "@fluxo/s3": "workspace:*",
    "@fluxo/types": "workspace:*",
    "@hono/node-server": "2.1.1",
    "hono": "4.13.7",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@fluxo/config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
