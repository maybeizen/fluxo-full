# =============================================================================
# Fluxo environment
# =============================================================================
# Copy this file to `.env` at the repository root:
#   cp .env.example .env
#
# The API and CLI load `.env` from the repo root. The frontend Vite app also
# reads this file (envDir is the repo root). Only variables prefixed with
# VITE_ are exposed to the browser.
#
# Generate secrets with:
#   openssl rand -hex 32
# =============================================================================

# --- App ---------------------------------------------------------------------
# Runtime mode. One of: development | test | production
NODE_ENV=development

# HTTP port for the API process
PORT=3000

# Origin of the SPA. Used as the API CORS allowlist.
FRONTEND_URL=http://localhost:5173

# Public URL of the API. Used by the CLI health command and server-side links.
API_URL=http://localhost:3000

# Display name shown in the panel and outgoing mail defaults
APP_NAME=Fluxo

# Master key for encrypting stored secrets (SMTP, Turnstile, etc.).
# Required before enabling encryption. Do not commit a real value.
APP_KEY=

# Signed-session HMAC secret. Required before enabling auth.
# Use a different value from APP_KEY.
SESSION_SECRET=

# How long a session cookie stays valid, in days
SESSION_LIFETIME=7

# Cost factor for password hashes. 10–15 is typical; 12 is the default.
BCRYPT_ROUNDS=12

# Optional cookie Domain attribute. Leave empty for host-only cookies.
COOKIE_DOMAIN=

# --- Database ----------------------------------------------------------------
# PostgreSQL connection string. Required once billing/auth persist data.
# Matches docker-compose.yml (user/password/db = fluxo).
POSTGRES_URL=postgres://fluxo:fluxo@localhost:5432/fluxo

# --- Redis -------------------------------------------------------------------
# Required. The API will not start if this is missing or unreachable.
REDIS_URL=redis://localhost:6379

# --- Email (optional) --------------------------------------------------------
# SMTP can be set here or later from the admin settings UI. Leave blank to
# skip outbound mail until configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# --- Storage (optional) ------------------------------------------------------
# Provider: local | s3
# local writes to ./storage at the repo root when no S3 credentials are set.
STORAGE_PROVIDER=local

# Used when STORAGE_PROVIDER=s3. All four identity fields are required then.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# true for MinIO / path-style endpoints; false for virtual-hosted AWS.
S3_FORCE_PATH_STYLE=true

# Optional public base for object URLs, e.g. https://cdn.example.com
S3_PUBLIC_URL_BASE=

# --- Plugins (optional) ------------------------------------------------------
# Directory of built plugin ESM files, relative to the process working directory.
# Defaults to ./plugins at the repo root.
PLUGINS_DIR=./plugins

# Comma-separated hostnames or literal IPs plugins may call over HTTP.
# Empty means no outbound plugin HTTP is allowed.
# Example: panel.example.com,10.0.0.12
PLUGIN_HTTP_ALLOWLIST=

# --- Frontend (Vite, public) -------------------------------------------------
# Browser-visible API origin. Must be prefixed with VITE_ to reach the SPA.
# Usually the same value as API_URL.
VITE_PUBLIC_API_URL=http://localhost:3000
